# Copia este archivo a .env y reemplaza TODOS los valores. .env esta en .gitignore.

# SQL Server (contenedor sql-server-2022)
MSSQL_SA_USER=sa
MSSQL_SA_PASSWORD=<password-sa-del-contenedor>
SA_PASSWORD=<igual-que-MSSQL_SA_PASSWORD>
MSSQL_SERVER=localhost,1433
MSSQL_DATABASE=WideWorldImporters

# Cuenta de minimo privilegio usada por backend y ML (la crea database/apply_dw_layer.py)
APP_DB_USER=wwi_app
APP_DB_PASSWORD=<password-aleatorio-largo>

# Backend (Node.js)
BACKEND_PORT=4000
JWT_SECRET=<hex-aleatorio-de-64-caracteres>
DEMO_ADMIN_PASSWORD=<password-demo-admin>
DEMO_ANALYST_PASSWORD=<password-demo-analyst>
CORS_ORIGIN=http://localhost:5173

# IA generativa (Ollama local, sin enviar datos a terceros)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Correo de alertas (opcional; sin SMTP_HOST las alertas por correo quedan 'skipped')
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
