# Environment Variables Template
# Copy this to .env and fill with real values

# SQL Server Configuration
SA_PASSWORD=YourSecurePassword123!
MSSQL_SA_PASSWORD=YourSecurePassword123!
MSSQL_PID=Developer

# Database Names
SOURCE_DB=WideWorldImporters
STAGING_DB=WideWorldImporters_Staging
DW_DB=WideWorldImporters_DW

# ETL Configuration
ETL_LOG_LEVEL=INFO
ETL_BATCH_SIZE=10000

# Backend API
BACKEND_PORT=8000
DATABASE_URL=mssql+pyodbc://sa:YourSecurePassword123!@mssql:1433/WideWorldImporters_DW?driver=ODBC+Driver+17+for+SQL+Server

# Frontend
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000

# Machine Learning
MODEL_PATH=/app/models/sales_forecast_model.pkl
ML_RETRAIN_DAYS=30

# Generative AI
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=neural-chat

# Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/platform.log
